# Copy to .env and enter the real key there. Never commit .env.
# Use the key, base URL, and model ID from the same provider.
# Direct Anthropic: https://api.anthropic.com with a model available to your account.
ANTHROPIC_BASE_URL=https://api.gluapi.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
MODEL_TIMEOUT_SECONDS=30

DATABASE_PATH=data/support.db
DOCS_BASE_URL=https://docs.ampere.sh/docs
DISCORD_MODE=mock
# success or failure; used to verify pending-ticket behavior.
MOCK_DISCORD_RESULT=success

